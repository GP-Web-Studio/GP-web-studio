# ========================================================
# Gryp WhatsApp Chatbot - Variables de Entorno
# Copia este archivo a .env y completa con tus credenciales
# ========================================================

# Puerto del servidor local
PORT=3000

# --------------------------------------------------------
# 1. Configuración de Meta for Developers (WhatsApp Cloud API)
# --------------------------------------------------------
# Token inventado por ti para validar el webhook en Meta Developers
META_VERIFY_TOKEN=gryp_secure_verify_token_2025

# Token de acceso temporal o permanente generado en developers.facebook.com
META_ACCESS_TOKEN=TU_TOKEN_DE_ACCESO_DE_META

# Phone Number ID asignado por Meta en la consola de WhatsApp
META_PHONE_NUMBER_ID=TU_PHONE_NUMBER_ID_DE_META

# Versión de Graph API (por defecto v21.0)
META_GRAPH_VERSION=v21.0

# --------------------------------------------------------
# 2. Configuración de Inteligencia Artificial (OpenAI)
# --------------------------------------------------------
# Tu clave secreta de OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-TU_OPENAI_API_KEY

# Modelo recomendado: gpt-4o-mini (rápido, económico y de alta calidad)
OPENAI_MODEL=gpt-4o-mini

# --------------------------------------------------------
# 3. Notificaciones y Derivación a Humano (Opcional)
# --------------------------------------------------------
# Número del asesor para derivaciones (formato internacional sin signos, ej: 59899259908)
AGENT_ALERT_PHONE=59899259908
